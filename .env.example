# Copy to `.env` (git-ignored) and fill in real values. Placeholders only.
LEJEPA_NORM_DATA_DIR=/path/to/data
LEJEPA_NORM_RUNS_DIR=/path/to/runs
LEJEPA_NORM_EMBED_DIR=/path/to/embeddings
LEJEPA_NORM_NOTES_DIR=/path/to/repo/research_notes
LEJEPA_NORM_KALEIDO_CHROME=/path/to/chrome
# Optional: interpreter used by the SLURM templates when the venv is not ./.venv
# (e.g. when UV_PROJECT_ENVIRONMENT points at scratch).
LEJEPA_NORM_PYTHON=/path/to/venv/bin/python
